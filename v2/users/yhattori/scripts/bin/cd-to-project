#!/usr/bin/env bash
# cd-to-project — fuzzy-open a repo in a new zellij tab.
#
# Lists ~/Documents/repositories and opens the picked directory as a new zellij
# tab (needs fzf + zellij).

selected=$(find ~/Documents/repositories -mindepth 1 -maxdepth 2 -type d -not -iwholename '*.git*' | fzf)
if [ -n "$selected" ]; then
	zellij action new-tab --name "$(basename "$selected")" --cwd "$selected" || exit
fi
